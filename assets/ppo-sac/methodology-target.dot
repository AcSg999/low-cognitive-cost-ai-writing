digraph target {
    graph [charset="UTF-8", bgcolor="#FFFFFF", pad=0.15, ranksep=0.35, nodesep=0.24,
           splines=ortho, newrank=true, fontname="Microsoft YaHei", fontsize=15, fontcolor="#18352E"]
    node [shape=box, style="rounded,filled", height=0.5, margin="0.14,0.1",
          fontname="Microsoft YaHei", fontsize=14, fontcolor="#18352E", penwidth=1.1,
          fillcolor="#EAF3E8", color="#8CA786"]
    edge [color="#536760", penwidth=1.13, arrowsize=0.66]

    subgraph cluster_replay {
        label=<<B>实测回放记录</B>>
        style="rounded,filled"; color="#D5E0DA"; fillcolor="#F5F9F7"; margin=13
        index [label="旧状态动作对 (s, a)\n定位拟合对象", width=1.8, group=left, fillcolor="#E3F2F8", color="#74A7BD"]
        reward [label="即时奖励 r\n终止标记 d", width=1.55, group=middle, fillcolor="#E3F2F8", color="#74A7BD"]
        next_state [label="下一状态 s′", width=2.25, group=right, fillcolor="#E3F2F8", color="#74A7BD"]
        { rank=same; index; reward; next_state; }
        index -> reward -> next_state [style=invis]
    }

    subgraph cluster_estimate {
        label=<<B>训练时重算</B>>
        labeljust=l; style="rounded,filled"; color="#D5E0DA"; fillcolor="#F5F9F7"; margin=13
        act [label="当前策略采样 a′", width=2.25, group=right]
        score [label="目标 Q 取小值并加熵项", width=2.25, group=right]
        act -> score [weight=8]
    }

    target [label="合成训练目标 y", width=2.1, group=middle, fillcolor="#FFF0DC", color="#C49A60"]
    fit [label="以 y 拟合在线 Q(s, a)", width=2.6, group=middle]

    next_state -> act [weight=8]
    reward -> target [weight=8]
    score -> target
    target -> fit [weight=10]
    index -> fit [style=dashed]
}
